# Weaviate connection (local Docker instance)
WEAVIATE_HTTP_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_HOST=localhost
WEAVIATE_GRPC_PORT=50051
# Leave empty for a local instance with anonymous access enabled (default docker-compose setup).
WEAVIATE_API_KEY=

# Embedding model (Hugging Face, 768-dim)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5

# Weaviate collections - one per source document type, same 8-property
# schema, ingested via the same generic pipeline (src/pipeline.py)
PRODUCT_SPECS_COLLECTION=product_specs
TECHNICAL_SPECS_COLLECTION=technical_specs
REFUND_SPECS_COLLECTION=refund_specs

# Chunking (token-based, counted with the embedding model's own tokenizer)
CHUNK_SIZE_TOKENS=300
CHUNK_OVERLAP_TOKENS=40

# Logging
LOG_FILE_PATH=logs/ingestion.log
LOG_LEVEL=INFO

# Where source PDFs live: data/<collection_name>/<file>.pdf
DATA_DIR=data

# Local ledger used to make re-ingestion idempotent/resumable
LEDGER_FILE_PATH=logs/ingestion_ledger.json
